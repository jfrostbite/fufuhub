# Server Configuration
PORT=3001
NODE_ENV=development

# Redis Configuration
# Upstash (TLS enabled): rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
# Local / Self-hosted: redis://127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0


# API Configuration
API_BASE_URL=https://h5-proxy.fdcompute.com

# Task Configuration
# Token refresh check interval (ms)
TOKEN_REFRESH_INTERVAL=300000
# Task check interval (ms)
TASK_CHECK_INTERVAL=30000
# Heartbeat active time window (hour: 0-23)
HEARTBEAT_START_HOUR=10
HEARTBEAT_END_HOUR=22

# Logging
LOG_LEVEL=info

# Persistent Storage (Optional)
# DATA_DIR=./data
# USERS_FILE_PATH=./data/users.json
